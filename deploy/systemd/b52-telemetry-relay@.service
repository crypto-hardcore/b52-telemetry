[Unit]
Description=B-52 confined telemetry relay (%i)
After=network-online.target b52@%i.service
Wants=network-online.target

[Service]
Type=simple
User=b52
Group=b52
UMask=0077
StateDirectory=b52-relay/%i
StateDirectoryMode=0700
ConfigurationDirectory=b52-relay/%i
ConfigurationDirectoryMode=0750
EnvironmentFile=/etc/b52-relay/%i/relay.env
LoadCredential=producer.token:/etc/b52-relay/%i/producer.token
AppArmorProfile=b52-relay-%i
ExecStart=/opt/b52-telemetry/venv/bin/b52-telemetry-relay
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/b52/%i/data/telemetry.latest.json
ReadWritePaths=/var/lib/b52-relay/%i
InaccessiblePaths=/var/lib/b52/%i/data/b52.sqlite3
InaccessiblePaths=/var/lib/b52/%i/data/b52.sqlite3-wal
InaccessiblePaths=/var/lib/b52/%i/data/b52.sqlite3-shm
InaccessiblePaths=/var/log/b52/%i
InaccessiblePaths=/etc/b52/%i
InaccessiblePaths=/run/b52/%i

[Install]
WantedBy=multi-user.target
