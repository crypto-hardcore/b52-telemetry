# Read-only canonical telemetry sources keyed by stable B-52 instance ID.
B52_TELEMETRY_SOURCES={"B52-001":"/var/lib/b52/B52-001/telemetry/telemetry.jsonl","B52-002":"/var/lib/b52/B52-002/telemetry/telemetry.jsonl"}

# Secret used to establish restricted browser telemetry sessions.
B52_TELEMETRY_ACCESS_KEY=replace-with-production-secret
